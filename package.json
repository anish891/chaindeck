{
  "name": "chaindeck",
  "version": "1.0.0",
  "description": "ChainDeck: live NIFTY and SENSEX option chain analytics from the Upstox API (OI, GEX, volatility, alerts)",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "node api/index.js",
    "test": "npm run typecheck:paper && node test/run.js",
    "build:paper": "vite build --config paper-app/vite.config.mjs",
    "dev:paper": "vite --config paper-app/vite.config.mjs",
    "typecheck:paper": "tsc -p paper-app"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
