# Copy to .env.local for local runs, and set the same names in the server's environment.

# Upstox read-only Analytics Token (Developer Apps -> Analytics -> Generate Token). Valid for one year.
UPSTOX_ACCESS_TOKEN=

# Upstash Redis (optional locally: without it, history lives in memory and is lost on restart)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CRON_SECRET guards the manual POST /api/session-summary; PAPER_SECRET is the paper trading owner sign-in.
# In production also set NODE_ENV=production so both are mandatory.
CRON_SECRET=
PAPER_SECRET=

# Optional: also open Upstox's Portfolio Stream (real order / position / holding updates). Paper trading does not need it.
UPSTOX_PORTFOLIO_STREAM=
