# Copy to .env.local for local runs, and set the same names in the Vercel project settings.

# Upstox read-only Analytics Token (Developer Apps -> Analytics -> Generate Token). Valid for one year.
UPSTOX_ACCESS_TOKEN=

# Upstash Redis (optional locally: without it, history lives in memory and is lost on restart)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secrets for the cron endpoints and the paper trading app
CRON_SECRET=
PAPER_SECRET=

# Option chain source: upstox (default when a token is set) or nse (the old scraper, kept as a fallback)
DATA_SOURCE=
